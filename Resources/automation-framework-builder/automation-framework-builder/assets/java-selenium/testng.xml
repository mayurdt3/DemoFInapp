<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="{{PROJECT_NAME}} Suite" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <listeners>
    <listener class-name="com.automation.listeners.TestListener"/>
    <listener class-name="com.automation.listeners.RetryTransformer"/>
  </listeners>
  <test name="Automation Tests">
    <packages>
      <package name="com.automation.tests"/>
      <package name="com.automation.api"/>
    </packages>
  </test>
</suite>
